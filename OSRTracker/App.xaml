<?xml version="1.0" encoding="utf-8"?>
<Application
  x:Class="OSRTracker.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:c="using:CommunityToolkit.WinUI.Converters"
  xmlns:c2="using:OSRTracker.Views.Converters"
  xmlns:local="using:OSRTracker">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <ResourceDictionary Source="/Styles/FontSizes.xaml" />
        <ResourceDictionary Source="/Styles/Thickness.xaml" />
        <ResourceDictionary Source="/Styles/TextBlock.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <c:BoolToVisibilityConverter x:Key="boolToVis" />
      
      <c:BoolToObjectConverter x:Key="invertBoolToVis">
        <c:BoolToObjectConverter.TrueValue>
          <Visibility>Collapsed</Visibility>
        </c:BoolToObjectConverter.TrueValue>
        <c:BoolToObjectConverter.FalseValue>
          <Visibility>Visible</Visibility>
        </c:BoolToObjectConverter.FalseValue>
      </c:BoolToObjectConverter>

    </ResourceDictionary>
  </Application.Resources>
</Application>
