<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="OSRTracker.Views.Pages.GamePlay.ApplyDelveXPDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OSRTracker.Views.Pages.GamePlay"
  xmlns:vm="using:OSRTracker.ViewModels.Pages.GamePlay"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  
  
  Width="400"
  Height="500"
  Title="Apply Session XP"
  
  PrimaryButtonCommand="{x:Bind ViewModel.PrimaryCommand}"
  PrimaryButtonText="{x:Bind ViewModel.PrimaryText}"
  
  CloseButtonText="{x:Bind ViewModel.CloseText}"
  
    mc:Ignorable="d"
  >

  <Grid>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="Apply Delve XP" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" Style="{StaticResource HeaderTextBlockStyle}" />


    <ComboBox ItemsSource="{x:Bind vm:DelveCalculationMethodVM.AvailableMethods}"
              SelectedItem="{x:Bind ViewModel.SelectedMethod, Mode=TwoWay}"
              DisplayMemberPath="Name" />
    
    <tv:TableView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Characters}">
      <tv:TableView.Columns>
        <tv:TableViewTextColumn Binding="{Binding Path=Name}" IsReadOnly="True" Header="Character" />
        <tv:TableViewNumberColumn Binding="{Binding Path=CurrentXP}" IsReadOnly="True" Header="Current XP" />
        <tv:TableViewNumberColumn Binding="{Binding Path=XP}" Header="Session XP" />
        <tv:TableViewNumberColumn Binding="{Binding Path=BonusXP}" Header="Bonus XP" />
        <tv:TableViewNumberColumn Binding="{Binding Path=NextXP}" Header="Next Level XP" />
      </tv:TableView.Columns>
    </tv:TableView>


  </Grid>
</ContentDialog>
