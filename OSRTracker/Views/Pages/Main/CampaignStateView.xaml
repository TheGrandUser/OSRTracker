<?xml version="1.0" encoding="utf-8"?>
<UserControl
  x:Class="OSRTracker.Views.Pages.Main.CampaignStateView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:OSRTracker.Views.Pages.Main"
  xmlns:vm="using:OSRTracker.ViewModels.Pages.Main"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:cv="using:OSRTracker.Views.Converters"
  Name="rootControl"
  Margin="3"
  mc:Ignorable="d">

  <UserControl.Resources>

    <DataTemplate x:Key="SessionCharacterTemplate" x:DataType="vm:CharacterSummaryVM">
      <ItemContainer>
        <TextBlock Text="{Binding Path=Name}" />
      </ItemContainer>
    </DataTemplate>

    <cv:BoolToBrushConverter x:Key="activeSessionBackground" TrueBrush="#DFD" FalseBrush="#EEE" />

    <DataTemplate x:Key="SessionTrackTemplate" x:DataType="vm:SessionTrackVM">
      <ItemContainer Name="sessionTrackContainer"
                     Background="{Binding Path=IsActiveSession, Converter={StaticResource activeSessionBackground}}"
                     AllowDrop="True"
                     DragOver="{x:Bind DragOverHandler}"
                     Drop="{x:Bind DropHandler}">

        <Border BorderBrush="#444" BorderThickness="2"
                Height="200" Padding="4">

          <Grid Margin="3">

            <Grid.RowDefinitions>
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
              <RowDefinition />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Path=Name}" Style="{StaticResource ListTitleStyle}" />

            <!--<controls:SwitchPresenter Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Value="{Binding Path=HasSession, Mode=OneWay}"
                                    TargetType="vm:SessionState" VerticalAlignment="Top">
              <controls:Case Value="InactiveSession">
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ResourceKey=SubtleButtonStyle}"
                      Command="{Binding ElementName=rootControl, Path=ViewModel.ResumeSessionCommand}" CommandParameter="{Binding}">
                  <TextBlock>Resume <Run Text="{Binding Path=CurrentSessionNumber}" /></TextBlock>
                </Button>
              </controls:Case>
              <controls:Case Value="ActiveSession">
                <TextBlock>Active</TextBlock>
              </controls:Case>
              <controls:Case Value="NoSession">
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource ResourceKey=SubtleButtonStyle}"
                      Command="{Binding ElementName=rootControl, Path=ViewModel.CreateNewSessionCommand}" CommandParameter="{Binding}">
                  New Session
                </Button>
              </controls:Case>
              <controls:Case IsDefault="True">
                <TextBlock>Could not figure state value</TextBlock>
              </controls:Case>
            </controls:SwitchPresenter>-->


            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Path=GroupDescription}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Path=CurrentSessionTitle}"
                       Style="{StaticResource ListSubTitleStyle}"/>

            <GridView Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" ItemsSource="{Binding Path=Characters}" IsItemClickEnabled="False"
                      ItemTemplate="{StaticResource SessionCharacterTemplate}"
                      SelectionMode="None"
                      />

          </Grid>

        </Border>
      </ItemContainer>

    </DataTemplate>

    <DataTemplate x:Key="CharacterTemplate" x:DataType="vm:CharacterSummaryVM">
      <ItemContainer BorderBrush="SlateGray" BorderThickness="2" Margin="2 5"
                     CanDrag="True"
                     DragStarting="CharactersView_DragStarting">
        <StackPanel>
          <TextBlock Text="{Binding Path=Name}"></TextBlock>
          <TextBlock>Level <Run Text="{Binding Path=Level}"/> <Run Text="{Binding Path=ClassName}"/></TextBlock>
        </StackPanel>
      </ItemContainer>
    </DataTemplate>

  </UserControl.Resources>

  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>


    <TextBlock Grid.ColumnSpan="2" Margin="3" FontSize="24">Campaign <Run Text="{x:Bind ViewModel.Name}"/></TextBlock>


    <ListView x:Name="SessionTrackView" Grid.Column="0" Grid.Row="1" ItemTemplate="{StaticResource ResourceKey=SessionTrackTemplate}"
              ItemsSource="{x:Bind ViewModel.SessionTracks}"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              Margin="10"
              
              SelectionMode="Single">

      <ListView.Header>
        <Button Style="{StaticResource SubtleButtonStyle}" x:Name="AddSessionTrack" Click="AddSessionTrack_Click">Add</Button>
      </ListView.Header>
    </ListView>

    <ListView x:Name="CharactersView" Grid.Column="1" Grid.Row="1" ItemTemplate="{StaticResource ResourceKey=CharacterTemplate}"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
               Margin="10"
               ItemsSource="{x:Bind Path=ViewModel.CharacterSummaries}">

    </ListView>

  </Grid>
</UserControl>
