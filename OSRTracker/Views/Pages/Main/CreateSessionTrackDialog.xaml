<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
  x:Class="OSRTracker.Views.Pages.Main.CreateSessionTrackDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:OSRTracker.Views.Pages.Main"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  
  PrimaryButtonText="Create"
  IsSecondaryButtonEnabled="False"
  CloseButtonText="Cancel"
  
  mc:Ignorable="d">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition />
      <RowDefinition />
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0">Name:</TextBlock>
    <TextBox x:Name="TrackNameTB" Grid.Row="0" Grid.Column="1" />

    <TextBlock Grid.Row="1" Grid.Column="0">Description:</TextBlock>
    <TextBox x:Name="DescriptionTB" Grid.Row="1" Grid.Column="1"  />

  </Grid>
</ContentDialog>
