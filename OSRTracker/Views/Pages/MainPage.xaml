      </Grid.RowDefinitions>

      <CommandBar Background="Transparent" HorizontalAlignment="Left">
        <AppBarButton Icon="Document" Label="New" Command="{x:Bind ViewModel.CreateCampaignCommand}" />
        <AppBarButton Icon="OpenFile" Label="Open" Command="{x:Bind ViewModel.OpenCampaignCommand}" />
        
        <AppBarButton Icon="Clock" Label="Tet Busy" Command="{x:Bind ViewModel.TestBusyCommand}" />
      </CommandBar>

      <Grid Grid.Row="1">

        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.CampaignsView}"
                ItemTemplate="{StaticResource recentFile}">

        </GridView>
      </Grid>

    </Grid>

  </Grid>-->
</Page>
