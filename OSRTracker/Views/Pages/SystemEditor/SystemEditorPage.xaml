<?xml version="1.0" encoding="utf-8"?>
<Page
  x:Class="OSRTracker.Views.Pages.SystemEditorPage"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:OSRTracker.Views.Pages"
  xmlns:vm="using:OSRTracker.ViewModels"
  xmlns:controls="using:CommunityToolkit.WinUI.Controls"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:ts="using:OSRTracker.Views.TemplateSelectors"
  mc:Ignorable="d">

  <Grid>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    
    <StackPanel Orientation="Vertical" Grid.Row="0">

      <StackPanel Orientation="Horizontal">
        <!--<TextBlock>Campaign Name:</TextBlock>-->
        <TextBox Header="Campaign Name" Text="{x:Bind ViewModel.Name, Mode=TwoWay}" />
        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.ImportSystemCommand}">Import</Button>
        <Button HorizontalAlignment="Right" Command="{x:Bind ViewModel.ExportSystemCommand}">Export</Button>
      </StackPanel>

      <StackPanel Orientation="Horizontal">
        <!--<TextBlock>System Name:</TextBlock>-->
        <TextBox Header="System Name" Text="{x:Bind ViewModel.SystemName, Mode=TwoWay}" />
      </StackPanel>

      <TextBlock>Attributes</TextBlock>

      <GridView ItemsSource="{x:Bind ViewModel.Attributes}" 
              SelectionMode="None"
              CanDragItems="False"
              AllowDrop="False"
              CanReorderItems="False">
        <GridView.ItemTemplate>
          <DataTemplate>
            <TextBox Text="{Binding Path=Name, Mode=TwoWay}" Width="60" />
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

    </StackPanel>


    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="200" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Button Command="{x:Bind ViewModel.AddClassCommand}" Grid.Row="0" Grid.Column="0">+</Button>

      <ListBox Grid.Row="1" VerticalAlignment="Stretch"
        ItemsSource="{x:Bind ViewModel.ClassesView}"
        SelectedItem="{x:Bind ViewModel.SelectedClass, Mode=TwoWay}"
        DisplayMemberPath="Name">

      </ListBox>

      <controls:GridSplitter Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Stretch" Margin="1" Width="6" />

      <ContentControl Grid.Column="2" Grid.RowSpan="2" Content="{x:Bind ViewModel.SelectedClass, Mode=OneWay}" VerticalAlignment="Stretch">

        <ContentControl.Resources>

          <DataTemplate x:Key="SelectedClassTemplate">
            <local:ClassDefinitionDetailControl ViewModel="{Binding}" DataContext="{Binding}" />
          </DataTemplate>

          <DataTemplate x:Key="NoSelectionTemplate">
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="No class selected" />
          </DataTemplate>

        </ContentControl.Resources>

        <ContentControl.ContentTemplateSelector>
          <ts:ItemOrNothingTemplateSelector NothingTemplate="{StaticResource NoSelectionTemplate}" ItemTemplate="{StaticResource SelectedClassTemplate}" />
        </ContentControl.ContentTemplateSelector>
      </ContentControl>

    </Grid>
  </Grid>
</Page>
