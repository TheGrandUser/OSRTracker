<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OSRTracker.Views.Pages.ClassDefinitionDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OSRTracker.Views.Pages"
    xmlns:vm="using:OSRTracker.ViewModels"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    mc:Ignorable="d">

  <Grid>

    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="Class Name:" Grid.Row="0" Grid.Column="0" />
    <TextBox Header="Class Name" Text="{Binding Name, Mode=TwoWay}" Grid.Row="0" Grid.Column="1" />


    <controls:TokenizingTextBox Grid.Row="1" Grid.ColumnSpan="2" x:Name="KeyAttributesTextBox"
                                PlaceholderText="Key Attributes"
                                TokenDelimiter=","
                                ItemsSource="{Binding KeyAttributes, Mode=TwoWay}"
                                SuggestedItemsSource="{Binding Attributes, Mode=OneWay}"
                                MaximumTokens="6"
                                DisplayMemberPath="Name"
                                
                                TextMemberPath="Name"
                                TokenItemAdding="KeyAttributesTextBox_TokenItemAdding">
      
      <controls:TokenizingTextBox.HeaderTemplate>
        <DataTemplate>
          <TextBlock Text="Key Attributes" />
        </DataTemplate>
      </controls:TokenizingTextBox.HeaderTemplate>
      
      <controls:TokenizingTextBox.TokenItemTemplate>
        <DataTemplate>
          <controls:TokenizingTextBoxItem>
            <TextBlock Text="{Binding Path=Name}" />
          </controls:TokenizingTextBoxItem>
        </DataTemplate>
      </controls:TokenizingTextBox.TokenItemTemplate>
    
    </controls:TokenizingTextBox>


    <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Add Level" Command="{Binding AddLevelCommand, Mode=OneWay}" />
    <Button Grid.Row="2" Grid.ColumnSpan="2" Content="Remove Level" Command="{Binding RemoveLevelCommand, Mode=OneWay}" HorizontalAlignment="Right" />

    <tv:TableView x:Name="levelsTable" ItemsSource="{Binding Path=Levels, Mode=OneWay}" Grid.Row="3" Grid.ColumnSpan="2" AutoGenerateColumns="False" VerticalAlignment="Stretch">
      <tv:TableView.Columns>
        <tv:TableViewTextColumn Binding="{Binding Path=Level}" IsReadOnly="True" Header="Level" />
        <tv:TableViewTextColumn Binding="{Binding Path=XPRequired}" Header="XP" Width="100" />
      </tv:TableView.Columns>
    </tv:TableView>

  </Grid>
</UserControl>
